<UserControl x:Class="PCL.LauncherLanguageSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL">
    <local:MyCard Margin="0,15,0,0" Title="{DynamicResource Setup.Language.CardTitle}">
        <Grid Margin="25,40,25,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="9" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" VerticalAlignment="Center" Margin="0,0,25,0"
                Text="{DynamicResource Setup.Language.UiLanguage}" />
            <local:MyComboBox x:Name="ComboUiLanguage" Grid.Column="1"
                SelectionChanged="ComboUiLanguage_SelectionChanged" />
            <TextBlock Grid.Row="2" VerticalAlignment="Center" Margin="0,0,25,0"
                Text="{DynamicResource Setup.Language.FormatCulture}" />
            <local:MyComboBox x:Name="ComboUiFormatCulture" Grid.Row="2" Grid.Column="1"
                SelectionChanged="ComboUiFormatCulture_SelectionChanged" />
        </Grid>
    </local:MyCard>
</UserControl>
